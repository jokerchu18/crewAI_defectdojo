# Qdrant and local BGE-M3 Text Embeddings Inference service.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_BASE_DIR=data/knowledge
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHARS=6000
KNOWLEDGE_MIN_SIMILARITY=0.35
ROUTER_FALLBACK_CONFIDENCE_THRESHOLD=0.7
ROUTER_FALLBACK_TOP_K=4
ROUTER_FALLBACK_MIN_SIMILARITY=0.75
ROUTER_FALLBACK_MIN_CONSENSUS=2

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=defectdojo_knowledge
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PREFER_GRPC=false

EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=local-bge-m3
