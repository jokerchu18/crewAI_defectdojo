# Qdrant and local BGE-M3 Text Embeddings Inference service.
KNOWLEDGE_ENABLED=true
KNOWLEDGE_BASE_DIR=data/knowledge
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHARS=6000
KNOWLEDGE_MIN_SIMILARITY=0.35
ROUTER_FALLBACK_CONFIDENCE_THRESHOLD=0.7
ROUTER_FALLBACK_TOP_K=4
ROUTER_FALLBACK_MIN_SIMILARITY=0.75
ROUTER_FALLBACK_MIN_CONSENSUS=2

CONTEXT_HISTORY_TOKEN_BUDGET=3000
CONTEXT_SUMMARY_TOKEN_BUDGET=400
CONTEXT_SUMMARY_INPUT_TOKEN_BUDGET=3000
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_MAX_CHARS=12000
CONTEXT_WORKFLOW_MAX_STEPS=8
CONTEXT_AGENT_OUTPUT_MAX_CHARS=4000

# Durable approval and resumable workflow state.
APPROVAL_DATABASE_PATH=data/approvals.db
WORKFLOW_DATABASE_PATH=data/workflows.db

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=defectdojo_knowledge
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PREFER_GRPC=false

EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_API_KEY=local-bge-m3

# Hybrid search (dense + sparse) for exact-match scenarios like CVE IDs.
# Requires EMBEDDING_PROVIDER=tei (or openai with a BGE-M3 compatible endpoint).
# Only library partition is enabled by default; add triage,remediation later.
HYBRID_SEARCH_ENABLED=false
HYBRID_SEARCH_SOURCE_TYPES=library
